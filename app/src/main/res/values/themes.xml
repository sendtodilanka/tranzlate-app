<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Window-level theme only — all real theming is Compose TranzlateTheme
         (DESIGN_SYSTEM §10).

         windowBackground is what the framework paints before the first Compose
         frame exists, and on Android 12+ it is also the splash-screen
         background (the platform falls back to it when it is a single colour).
         Without it we inherited the framework's ?colorBackground grey
         (#FAFAFA/#303030) — that was the cold-start flash.

         forceDarkAllowed=false: we ship our own values-night theme, so the
         platform's automatic dark conversion must never touch us. Moot for
         Compose today, but load-bearing for any View content (ad SDK, WebView)
         that lands later. -->
    <style name="Theme.Tranzlate" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- The LAUNCH theme. Android 12+ shows a splash whether we configure one or
         not, so this is about controlling the one that already appears rather
         than adding anything; core-splashscreen backports the same treatment to
         API 23+, which is where our minSdk 24 users live.

         Both colours point at @color/window_background so the splash, the window
         behind it and the first Compose frame are one continuous surface — no
         step, in either light or dark (the colour has a values-night variant).

         postSplashScreenTheme is what the activity switches to once the splash
         is dismissed; without it the app would keep the splash theme forever. -->
    <style name="Theme.Tranzlate.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Tranzlate</item>
    </style>
</resources>
