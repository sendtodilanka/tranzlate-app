<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Online tiers (GOT/GCT) + the active connectivity monitor (issue #61). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Makes the installed text-to-speech engines VISIBLE to this app (issue #130
        ruling U-4, audit P1). From API 30 a package this app has declared no
        interest in does not exist as far as its own PackageManager is concerned,
        and TextToSpeech resolves its engine with queryIntentServices from inside
        THIS process. Without this block that query returns nothing, the engine
        never initialises, and AndroidOfflineVoiceCatalog enumerates an empty set
        — every offline-voice mark disappears and the app tells the user this
        device has no offline voices. It fails closed and it fails SILENTLY:
        no exception, no log, nothing to notice.

        Measured caveat, recorded so nobody re-derives it from the comment above
        (experiment E-V1, docs/research/issue-130-e-v1-voice-enumeration.md):
        removing this block changed NOTHING on the emulator images available to
        us, because com.google.android.tts carries forceQueryable=true on them
        and is therefore visible to every app regardless. That is a property of
        that one package — a third-party engine a user has set as their default
        (Samsung, Acapela, Vocalizer, eSpeak) carries no such marking and is
        invisible without this. The block is kept on that basis and on Google's
        own package-visibility guidance for INTENT_ACTION_TTS_SERVICE; E-V1
        could not disconfirm it on the hardware to hand.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".TranzlateApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tranzlate">

        <!-- Per-brand AdMob app id via manifestPlaceholders (plan §4); inert until the
             ads SDK integration phase. Never a Google test id in prod. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- The launcher activity starts in the splash theme and switches to
             Theme.Tranzlate itself via postSplashScreenTheme (see themes.xml).
             The application tag keeps Theme.Tranzlate, so any future activity
             that is not a launch entry point does not inherit a splash. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Tranzlate.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
