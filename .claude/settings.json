{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.sh\"",
            "if": "Bash(git *)",
            "timeout": 40,
            "statusMessage": "Checking git guard rails"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.sh\"",
            "if": "Bash(gh *)",
            "timeout": 40,
            "statusMessage": "Checking merge guard rails"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-pr.sh\"",
            "if": "Bash(gh *)",
            "timeout": 15,
            "statusMessage": "Checking PR body carries its enumeration and repro"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-tracker.sh\"",
            "if": "Bash(gh *)",
            "timeout": 40,
            "statusMessage": "Checking the epic tracker carries this PR"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/device-claim.sh\"",
            "if": "Bash(adb *)",
            "timeout": 10,
            "statusMessage": "Checking whether someone else is driving the device"
          }
        ]
      }
    ]
  }
}
