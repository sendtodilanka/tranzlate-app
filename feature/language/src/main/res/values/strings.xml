    <string name="text_lang_data_dialog_once">Download once</string>
    <string name="text_lang_data_dialog_wait">Wait for Wi-Fi</string>
    <!-- The real catalog size, never the design's hardcoded 65 (plan §4). -->
    <plurals name="text_lang_search_hint">
        <item quantity="one">Search %1$d language</item>
        <item quantity="other">Search %1$d languages</item>
    </plurals>
    <!-- Denominator = offline-CAPABLE languages (59), not the 194-row catalog:
         "12 of 194 on device" would imply the other 182 are downloadable. -->
    <plurals name="text_lang_on_device_count">
        <item quantity="one">%1$d of %2$d on device</item>
        <item quantity="other">%1$d of %2$d on device</item>
    </plurals>
    <!-- Language picker (issue #15: now a full screen, not a sheet — the two
         title keys are REUSED verbatim from the interim sheet, C-3.
         Issue #117 production redesign: permanent search, ISO-code avatars,
         honest per-row offline state, A–Z rail. `text_guided_lang_search` is
         retired — the search is real, so the placeholder message is a lie. -->
    <string name="cd_text_lang_search">Search languages</string>
    <string name="cd_text_lang_clear">Clear search</string>
    <!-- Empty search is not a dead end (EDGE_CASES): name the query, offer the way back. -->
    <!-- Row states. No MB on a row we have not measured (plan R3); no % on a
         download ML Kit reports no progress for (plan R1). -->
    <!-- Row a11y: the name AND its state, because the icon alone says nothing. -->
    <string name="cd_text_lang_row_on_device">%1$s, on device</string>
    <string name="cd_text_lang_row_downloading">%1$s, downloading</string>
    <string name="cd_text_lang_row_downloadable">%1$s, available for offline use</string>
    <string name="cd_text_lang_row_online_only">%1$s, online only</string>
    <string name="cd_text_lang_row_failed">%1$s, download failed</string>
    <string name="cd_text_lang_download">Download %1$s for offline use</string>
    <!-- Never "Cancel": ML Kit has no cancel, so stopping IS removing (plan R2). -->
    <string name="cd_text_lang_stop">Stop download and remove %1$s</string>
    <string name="cd_text_lang_retry">Try downloading %1$s again</string>
    <!-- The picker owns its own back description: `cd_text_back` stays with the
         composer, and C-3 gives one key one home rather than two modules one name. -->
    <string name="cd_lang_back">Back</string>
</resources>
